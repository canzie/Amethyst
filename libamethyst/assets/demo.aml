<DockingLayer name="aml_dock" innerSpacing=2>
    <DockRegion zone="left" ratio=0.3>
        <PanelLayer name="Sidebar">
            <Frame size=[1, 0, 1, 0] backgroundColor=[0.2, 0.15, 0.3] cornerRadius=4>
                <TextButton text="Sidebar Button" fontSize=14 textColor=[1, 1, 1, 1] size=[0.9, 0, 0, 30] position=[0.05, 0, 0, 10] backgroundColor=[0.4, 0.2, 0.6] cornerRadius=4 textXAlignment="center" textYAlignment="center" />
            </Frame>
        </PanelLayer>
        <DockRegion zone="top" ratio=0.6>
            <PanelLayer name="Main">
                <Frame size=[1, 0, 1, 0] backgroundColor=[0.15, 0.15, 0.2]>
                    <TextLabel text="Main Panel" fontSize=18 textColor=[1, 1, 1, 1] size=[1, 0, 0, 30] backgroundTransparency=1.0 textXAlignment="center" textYAlignment="center" />
                </Frame>
            </PanelLayer>
            <PanelLayer name="Console">
                <Frame size=[1, 0, 1, 0] backgroundColor=[0.1, 0.1, 0.12]>
                    <TextLabel text="Console Output" fontSize=14 textColor=[0.7, 0.9, 0.7, 1] size=[1, 0, 0, 24] position=[0, 0, 0, 4] backgroundTransparency=1.0 textXAlignment="left" />
                </Frame>
            </PanelLayer>
        </DockRegion>
    </DockRegion>
</DockingLayer>
